# 忽略所有大型壓縮包（這些是導致你 500 Error 的主因）
*.zip
*.rar
*.7z
*.tar.gz

# 忽略影片與大型媒體檔案
*.mp4
車子資料/**/*.mp4
*.mov
*.avi

# 忽略訓練日誌（TensorBoard 等，檔案數量極多）
runs/
logs/
rl_pig_pen/logs_*/
rl_pig_pen/demonstrations/

# 忽略強化學習訓練產生的模型權重（通常很大）
#*.pth
#*.onnx
#*.pkl
#checkpoint/
#checkpoints/

# ROS
build/
devel/
install/
*.pyc
__pycache__/
*.egg-info/

# Gazebo
.gazebo/
*.log
/logs/rl_junction/
/logs/rl_junction_training/
/logs/rl_junction_demos/
/logs/rl_junction_fsm_demos/
/logs/rl_junction_pipeline/
/logs/rl_junction_v6*/
/logs/rl_junction_bc/
/logs/rl_junction_eval/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Build artifacts
*.o
*.a
*.so
CMakeCache.txt
cmake_install.cmake
Makefile

# Python virtual env
.venv/
**/.venv/
venv/
env/

# Local hardware setup references and exported Xavier audit reports
/scripts/setup_autostart_service_reference.sh
/patrol_settings_check.txt
