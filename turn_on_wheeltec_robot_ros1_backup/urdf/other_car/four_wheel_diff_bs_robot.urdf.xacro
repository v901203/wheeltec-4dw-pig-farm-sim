<?xml version="1.0"?>

<!-- 
  Wheeltec Robot with M10P-PHY LiDAR and Official ZED X Depth Camera
  This xacro file integrates the official Stereolabs ZED X model
-->

<robot name="wheeltec_robot" xmlns:xacro="http://wiki.ros.org/xacro">

    <!-- ==================== Include ZED Official Macros ==================== -->
    <xacro:include filename="../../zed_description/urdf/zed_macro.urdf.xacro" />

    <!-- ==================== 車體 (Base Link) ==================== -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.15" rpy="0 0 0" />
            <geometry>
                <box size="0.40 0.30 0.165"/>
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.15" rpy="0 0 0" />
            <geometry>
                <box size="0.40 0.30 0.165"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.15" rpy="0 0 0" />
            <mass value="15.0"/>
            <inertia ixx="0.379" ixy="0.0" ixz="0.0" iyy="0.589" iyz="0.0" izz="0.912"/>
        </inertial>
    </link>

    <!-- ==================== 左後輪 (Left Rear Wheel) ==================== -->
    <joint name="left_wheel_joint" type="continuous">
        <origin xyz="-0.14 0.175 0.075" rpy="1.57 0 0"/>
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <axis xyz="0 0 -1"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="left_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.05"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.5"/>
            <inertia ixx="0.0046" ixy="0.0" ixz="0.0" iyy="0.0046" iyz="0.0" izz="0.0089"/>
        </inertial>
    </link>

    <!-- ==================== 右後輪 (Right Rear Wheel) ==================== -->
    <joint name="right_wheel_joint" type="continuous">
        <origin xyz="-0.14 -0.175 0.075" rpy="1.57 0 0"/>
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <axis xyz="0 0 -1"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="right_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.05"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.5"/>
            <inertia ixx="0.0046" ixy="0.0" ixz="0.0" iyy="0.0046" iyz="0.0" izz="0.0089"/>
        </inertial>
    </link>

    <!-- ==================== 左前輪 (Left Front Wheel) ==================== -->
    <joint name="left_front_joint" type="continuous">
        <origin xyz="0.14 0.175 0.075" rpy="1.57 0 0"/>
        <parent link="base_link"/>
        <child link="left_front_link"/>
        <axis xyz="0 0 -1"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="left_front_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.05"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.5"/>
            <inertia ixx="0.0046" ixy="0.0" ixz="0.0" iyy="0.0046" iyz="0.0" izz="0.0089"/>
        </inertial>
    </link>

    <!-- ==================== 右前輪 (Right Front Wheel) ==================== -->
    <joint name="right_front_joint" type="continuous">
        <origin xyz="0.14 -0.175 0.075" rpy="1.57 0 0"/>
        <parent link="base_link"/>
        <child link="right_front_link"/>
        <axis xyz="0 0 -1"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="right_front_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.05"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.5"/>
            <inertia ixx="0.0046" ixy="0.0" ixz="0.0" iyy="0.0046" iyz="0.0" izz="0.0089"/>
        </inertial>
    </link>

    <!-- ==================== 雷達 (M10P-PHY LiDAR) ==================== -->
    <joint name="laser_joint" type="fixed">
        <origin xyz="0.0 0 0.245" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="laser_link"/>
    </joint>

    <link name="laser_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.0398" length="0.039"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.0398" length="0.039"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.2"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <!-- ==================== 官方 ZED X 深度相機 (Official ZED X Camera) ==================== -->
    <!-- 使用官方 ZED X 宏生成相機模型 -->
    <xacro:zed_camera name="zedx" model="zedx" enable_gnss="false">
        <origin xyz="0 0 0" rpy="0 0 0"/>
    </xacro:zed_camera>

    <gazebo reference="zedx_camera_link">
        <sensor name="zedx_depth_camera" type="depth">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <camera>
                <horizontal_fov>2.094</horizontal_fov>
                <image>
                    <width>2560</width>
                    <height>1440</height>
                    <format>R_FLOAT32</format>
                </image>
                <clip>
                    <near>0.2</near>
                    <far>40.0</far>
                </clip>
            </camera>
            <topic>/camera</topic>
        </sensor>
    </gazebo>

    <!-- Mount ZED X on the robot front -->
    <joint name="zedx_mount_joint" type="fixed">
        <origin xyz="0.2 0 0.095" rpy="0 0 0"/> 
        <parent link="base_link"/>
        <child link="zedx_camera_link"/>
    </joint>

    <!-- ==================== Gazebo 物理與材質設定 ==================== -->
    <gazebo reference="left_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="right_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="left_front_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="right_front_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="base_link">
        <material>Gazebo/White</material>
    </gazebo>

    <!-- M10P-PHY LiDAR Gazebo Plugin -->
    <!-- 規格: 360° 掃描, 20KHz 發射頻率, 12Hz 掃描頻率, 25m 最大範圍, 0.22° 角分辨率 -->
    <gazebo reference="laser_link">
        <sensor name="lidar" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>12</update_rate>
            <topic>scan</topic>
            <ray>
                <scan>
                    <horizontal>
                        <samples>1640</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.1</min>
                    <max>25.0</max>
                    <resolution>0.01</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.03</stddev>
                </noise>
            </ray>
        </sensor>
    </gazebo>

    <!-- ==================== Ignition/GZ Diff-Drive System Plugin ==================== -->
    <!-- 必須包在 robot 標籤內部，並使用正確的 name 和 filename -->
    <gazebo>
        <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.57</wheel_separation>
            <wheel_radius>0.109</wheel_radius>

            <!-- 確保發布頻率 -->
            <odom_publish_frequency>50</odom_publish_frequency>

            <!-- 指定 Odom 所在的參考座標系 -->
            <frame_id>odom</frame_id>

            <!-- 指定小車本身的座標系 -->
            <child_frame_id>base_link</child_frame_id>

            <!-- 發布 Transform Tree (TF) -->
            <publish_odom_tf>true</publish_odom_tf>

            <topic>/cmd_vel</topic>
        </plugin>
    </gazebo>

</robot>
