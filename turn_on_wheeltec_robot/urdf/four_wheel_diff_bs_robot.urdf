<?xml version="1.0" ?>
<robot name="wheeltec_robot">

    <!-- ==================== 車體 (Base Link) ==================== -->
    <link name="base_link">
        <visual>
            <origin xyz="0 0 0.16" rpy="0 0 0" />
            <geometry>
                <box size="0.67 0.53 0.150"/>
            </geometry>
            <material name="white">
                <color rgba="1 1 1 1"/>
            </material>
        </visual>

        <collision>
            <origin xyz="0 0 0.16" rpy="0 0 0" />
            <geometry>
                <box size="0.67 0.53 0.150"/>
            </geometry>
        </collision>

        <inertial>
            <origin xyz="0 0 0.16" rpy="0 0 0" />
            <mass value="15.0"/>
            <inertia ixx="0.379" ixy="0.0" ixz="0.0" iyy="0.589" iyz="0.0" izz="0.912"/>
        </inertial>
    </link>

    <!-- ==================== 左後輪 (Left Rear Wheel) ==================== -->
    <joint name="left_wheel_joint" type="continuous">
        <origin xyz="-0.3 0.285 0.109" rpy="1.57 0 0"/>
        <parent link="base_link"/>
        <child link="left_wheel_link"/>
        <axis xyz="0 0 -1"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="left_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.5"/>
            <inertia ixx="0.0046" ixy="0.0" ixz="0.0" iyy="0.0046" iyz="0.0" izz="0.0089"/>
        </inertial>
    </link>

    <!-- ==================== 右後輪 (Right Rear Wheel) ==================== -->
    <joint name="right_wheel_joint" type="continuous">
        <origin xyz="-0.3 -0.285 0.109" rpy="1.57 0 0"/>
        <parent link="base_link"/>
        <child link="right_wheel_link"/>
        <axis xyz="0 0 -1"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="right_wheel_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.5"/>
            <inertia ixx="0.0046" ixy="0.0" ixz="0.0" iyy="0.0046" iyz="0.0" izz="0.0089"/>
        </inertial>
    </link>

    <!-- ==================== 左前輪 (Left Front Wheel) ==================== -->
    <joint name="left_front_joint" type="continuous">
        <origin xyz="0.3 0.285 0.109" rpy="1.57 0 0"/>
        <parent link="base_link"/>
        <child link="left_front_link"/>
        <axis xyz="0 0 -1"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="left_front_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.5"/>
            <inertia ixx="0.0046" ixy="0.0" ixz="0.0" iyy="0.0046" iyz="0.0" izz="0.0089"/>
        </inertial>
    </link>

    <!-- ==================== 右前輪 (Right Front Wheel) ==================== -->
    <joint name="right_front_joint" type="continuous">
        <origin xyz="0.3 -0.285 0.109" rpy="1.57 0 0"/>
        <parent link="base_link"/>
        <child link="right_front_link"/>
        <axis xyz="0 0 -1"/>
        <dynamics damping="0.1" friction="0.1"/>
    </joint>

    <link name="right_front_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.04"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.109" length="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="1.5"/>
            <inertia ixx="0.0046" ixy="0.0" ixz="0.0" iyy="0.0046" iyz="0.0" izz="0.0089"/>
        </inertial>
    </link>

    <!-- ==================== 雷達 (LiDAR) ==================== -->
    <joint name="laser_joint" type="fixed">
        <origin xyz="0.0 0 0.26" rpy="0 0 0"/>
        <parent link="base_link"/>
        <child link="laser_link"/>
    </joint>

    <link name="laser_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.04" length="0.05"/>
            </geometry>
            <material name="blue">
                <color rgba="0 0 1 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <cylinder radius="0.04" length="0.05"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.2"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

<!-- ==================== 深度相機 (Depth Camera) ==================== -->
    <joint name="depth_camera_joint" type="fixed">
        <origin xyz="0.37 0 0.23" rpy="0 0 0"/> 
        <parent link="base_link"/>
        <child link="depth_camera_link"/>
    </joint>

    <link name="depth_camera_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.08 0.06 0.03"/>
            </geometry>
            <material name="black">
                <color rgba="0 0 0 1"/>
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <box size="0.08 0.06 0.03"/>
            </geometry>
        </collision>
        <inertial>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <mass value="0.2"/>
            <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
        </inertial>
    </link>

    <gazebo reference="depth_camera_link">
        <sensor name="depth_camera" type="camera">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>30</update_rate>
            <camera>
                <horizontal_fov>1.047</horizontal_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <depth>
                    <width>640</width>
                    <height>480</height>
                    <format>R32F</format>
                </depth>
                <clip>
                    <near>0.1</near>
                    <far>10.0</far>
                </clip>
            </camera>
            <!-- color 和 depth 會以 topic 名稱區分 -->
            <topic>/camera</topic>
        </sensor>
    </gazebo>

    <!-- ==================== Gazebo 物理與材質設定 ==================== -->
    <gazebo reference="left_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="right_wheel_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="left_front_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="right_front_link">
        <mu1>1.0</mu1>
        <mu2>1.0</mu2>
        <material>Gazebo/DarkGrey</material>
    </gazebo>
    <gazebo reference="base_link">
        <material>Gazebo/White</material>
    </gazebo>

    <gazebo reference="laser_link">
        <sensor name="lidar" type="gpu_lidar">
            <pose>0 0 0 0 0 0</pose>
            <always_on>true</always_on>
            <visualize>true</visualize>
            <update_rate>10</update_rate>
            <topic>scan</topic>
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples>
                        <resolution>1.0</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.15</min>
                    <max>12.0</max>
                    <resolution>0.015</resolution>
                </range>
                <noise>
                    <type>gaussian</type>
                    <mean>0.0</mean>
                    <stddev>0.01</stddev>
                </noise>
            </ray>
        </sensor>
    </gazebo>

    <!-- ==================== Ignition/GZ Diff-Drive System Plugin ==================== -->
    <!-- 必須包在 robot 標籤內部，並使用正確的 name 和 filename -->
    <gazebo>
        <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
            <left_joint>left_wheel_joint</left_joint>
            <right_joint>right_wheel_joint</right_joint>
            <wheel_separation>0.57</wheel_separation>
            <wheel_radius>0.109</wheel_radius>

            <!-- 確保發布頻率 -->
            <odom_publish_frequency>50</odom_publish_frequency>

            <!-- 指定 Odom 所在的參考座標系 -->
            <frame_id>odom</frame_id>

            <!-- 指定小車本身的座標系 -->
            <child_frame_id>base_link</child_frame_id>

            <!-- 發布 Transform Tree (TF) -->
            <publish_odom_tf>true</publish_odom_tf>

            <topic>/cmd_vel</topic>
        </plugin>
    </gazebo>

</robot>
