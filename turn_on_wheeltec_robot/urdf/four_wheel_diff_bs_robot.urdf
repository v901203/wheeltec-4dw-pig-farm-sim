<?xml version="1.0" ?>
<robot name="wheeltec_robot">

<!-- ==================== 車體 (Base Link) ==================== -->
<link name="base_link">
    <visual>
        <origin xyz="0 0 0.15" rpy="0 0 0" />
        <geometry>
            <box size="0.40 0.30 0.165"/>
        </geometry>
        <material name="white">
            <color rgba="1 1 1 1"/>
        </material>
    </visual>

    <collision>
        <origin xyz="0 0 0.15" rpy="0 0 0" />
        <geometry>
            <box size="0.40 0.30 0.165"/>
        </geometry>
    </collision>

    <inertial>
        <origin xyz="0 0 0.15" rpy="0 0 0" />
        <mass value="15.0"/>
        <inertia ixx="0.379" ixy="0.0" ixz="0.0" iyy="0.589" iyz="0.0" izz="0.912"/>
    </inertial>
</link>

<!-- ==================== 左後輪 (Left Rear Wheel) ==================== -->
<joint name="left_wheel_joint" type="continuous">
    <origin xyz="-0.14 0.175 0.075" rpy="1.57 0 0"/>
    <parent link="base_link"/>
    <child link="left_wheel_link"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.1" friction="0.1"/>
</joint>

<link name="left_wheel_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <cylinder radius="0.109" length="0.05"/>
        </geometry>
        <material name="black">
            <color rgba="0 0 0 1"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <cylinder radius="0.109" length="0.05"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="1.5"/>
        <inertia ixx="0.0046" ixy="0.0" ixz="0.0" iyy="0.0046" iyz="0.0" izz="0.0089"/>
    </inertial>
</link>

<!-- ==================== 右後輪 (Right Rear Wheel) ==================== -->
<joint name="right_wheel_joint" type="continuous">
    <origin xyz="-0.14 -0.175 0.075" rpy="1.57 0 0"/>
    <parent link="base_link"/>
    <child link="right_wheel_link"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.1" friction="0.1"/>
</joint>

<link name="right_wheel_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <cylinder radius="0.109" length="0.05"/>
        </geometry>
        <material name="black">
            <color rgba="0 0 0 1"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <cylinder radius="0.109" length="0.05"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="1.5"/>
        <inertia ixx="0.0046" ixy="0.0" ixz="0.0" iyy="0.0046" iyz="0.0" izz="0.0089"/>
    </inertial>
</link>

<!-- ==================== 左前輪 (Left Front Wheel) ==================== -->
<joint name="left_front_joint" type="continuous">
    <origin xyz="0.14 0.175 0.075" rpy="1.57 0 0"/>
    <parent link="base_link"/>
    <child link="left_front_link"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.1" friction="0.1"/>
</joint>

<link name="left_front_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <cylinder radius="0.109" length="0.05"/>
        </geometry>
        <material name="black">
            <color rgba="0 0 0 1"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <cylinder radius="0.109" length="0.05"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="1.5"/>
        <inertia ixx="0.0046" ixy="0.0" ixz="0.0" iyy="0.0046" iyz="0.0" izz="0.0089"/>
    </inertial>
</link>

<!-- ==================== 右前輪 (Right Front Wheel) ==================== -->
<joint name="right_front_joint" type="continuous">
    <origin xyz="0.14 -0.175 0.075" rpy="1.57 0 0"/>
    <parent link="base_link"/>
    <child link="right_front_link"/>
    <axis xyz="0 0 -1"/>
    <dynamics damping="0.1" friction="0.1"/>
</joint>

<link name="right_front_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <cylinder radius="0.109" length="0.05"/>
        </geometry>
        <material name="black">
            <color rgba="0 0 0 1"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <cylinder radius="0.109" length="0.05"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="1.5"/>
        <inertia ixx="0.0046" ixy="0.0" ixz="0.0" iyy="0.0046" iyz="0.0" izz="0.0089"/>
    </inertial>
</link>

<!-- ==================== 雷達 (M10P-PHY LiDAR) ==================== -->
<joint name="laser_joint" type="fixed">
    <origin xyz="0.0 0 0.245" rpy="0 0 0"/>
    <parent link="base_link"/>
    <child link="laser_link"/>
</joint>

<link name="laser_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <cylinder radius="0.0398" length="0.039"/>
        </geometry>
        <material name="blue">
            <color rgba="0 0 1 1"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <cylinder radius="0.0398" length="0.039"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
</link>

<!-- ==================== 深度相機 (ZED X Depth & RGB Camera) ==================== -->
<joint name="depth_camera_joint" type="fixed">
    <origin xyz="0.2 0 0.095" rpy="0 0 0"/> 
    <parent link="base_link"/>
    <child link="depth_camera_link"/>
</joint>

<link name="depth_camera_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <box size="0.175 0.03 0.04"/>
        </geometry>
        <material name="black">
            <color rgba="0 0 0 1"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <box size="0.175 0.03 0.04"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.25"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
</link>

<!-- ==================== 右側攝影機 (Right Camera) ==================== -->
<joint name="right_camera_joint" type="fixed">
    <parent link="base_link"/>
    <child link="right_camera_link"/>
    <!-- x=0 (車身中段), y=-0.15 (靠右), z=0.15 (高度), yaw=-1.5708 (向右看 90 度) -->
    <origin xyz="0 -0.15 0.15" rpy="0 0 -1.5708"/>
</joint>

<link name="right_camera_link">
    <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <box size="0.05 0.05 0.05"/>
        </geometry>
        <material name="black">
            <color rgba="0.1 0.1 0.1 1.0"/>
        </material>
    </visual>
    <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
            <box size="0.05 0.05 0.05"/>
        </geometry>
    </collision>
    <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.1"/>
        <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
</link>

<!-- ==================== Gazebo 物理與材質設定 ==================== -->
<gazebo reference="left_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/DarkGrey</material>
</gazebo>
<gazebo reference="right_wheel_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/DarkGrey</material>
</gazebo>
<gazebo reference="left_front_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/DarkGrey</material>
</gazebo>
<gazebo reference="right_front_link">
    <mu1>1.0</mu1>
    <mu2>1.0</mu2>
    <material>Gazebo/DarkGrey</material>
</gazebo>
<gazebo reference="base_link">
    <material>Gazebo/White</material>
</gazebo>

<!-- ==================== 感測器 Gazebo 插件 ==================== -->
<!-- M10P-PHY LiDAR -->
<gazebo reference="laser_link">
    <sensor name="lidar" type="gpu_lidar">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>12</update_rate>
        <topic>scan</topic>
        <ray>
            <scan>
                <horizontal>
                    <samples>1640</samples>
                    <resolution>1.0</resolution>
                    <min_angle>-3.14159</min_angle>
                    <max_angle>3.14159</max_angle>
                </horizontal>
            </scan>
            <range>
                <min>0.1</min>
                <max>25.0</max>
                <!-- 已退回 0.01 解析度 -->
                <resolution>0.01</resolution>
            </range>
            <noise>
                <type>gaussian</type>
                <mean>0.0</mean>
                <stddev>0.03</stddev>
            </noise>
        </ray>
    </sensor>
</gazebo>

<!-- 前方 ZED X 相機 (深度 + RGB) -->
<gazebo reference="depth_camera_link">
    <!-- 深度感測器 -->
    <sensor name="depth_camera" type="depth">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>12</update_rate>
        <camera>
            <horizontal_fov>2.094</horizontal_fov>
            <image>
                <width>640</width>
                <height>360</height>
                <format>R_FLOAT32</format>
            </image>
            <clip>
                <near>0.2</near>
                <far>40.0</far>
            </clip>
        </camera>
        <topic>/camera</topic>
    </sensor>

    <!-- RGB 彩色相機 (模擬 ZED X 的彩色鏡頭) -->
    <sensor name="rgb_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <camera>
            <horizontal_fov>2.094</horizontal_fov>
            <image>
                <width>1280</width>
                <height>720</height>
                <format>R8G8B8</format>
            </image>
            <clip>
                <near>0.2</near>
                <far>40.0</far>
            </clip>
        </camera>
        <topic>/camera/color/image_raw</topic>
    </sensor>
</gazebo>

<!-- 右側彩色相機 (側拍監視器) -->
<gazebo reference="right_camera_link">
    <sensor name="right_rgb_camera" type="camera">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>true</visualize>
        <update_rate>30</update_rate>
        <camera>
            <horizontal_fov>1.57</horizontal_fov> <!-- 90度廣角 -->
            <image>
                <width>1280</width>
                <height>720</height>
                <format>R8G8B8</format>
            </image>
            <clip>
                <near>0.1</near>
                <far>20.0</far>
            </clip>
        </camera>
        <topic>/camera_right/image_raw</topic>
    </sensor>
</gazebo>

<!-- ==================== Ignition/GZ Diff-Drive System Plugin (4WD) ==================== -->
<gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
        <!-- 定義左側所有輪子 (前 + 後) -->
        <left_joint>left_front_joint</left_joint>
        <left_joint>left_wheel_joint</left_joint>
        
        <!-- 定義右側所有輪子 (前 + 後) -->
        <right_joint>right_front_joint</right_joint>
        <right_joint>right_wheel_joint</right_joint>
        
        <wheel_separation>0.57</wheel_separation>
        <wheel_radius>0.109</wheel_radius>

        <odom_publish_frequency>50</odom_publish_frequency>
        <frame_id>odom</frame_id>
        <child_frame_id>base_link</child_frame_id>
        <publish_odom_tf>true</publish_odom_tf>
        <topic>/cmd_vel</topic>
    </plugin>
</gazebo>

</robot>
